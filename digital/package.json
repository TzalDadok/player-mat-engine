{
  "name": "aoe-boardgame-digital",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --config client/vite.config.ts",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "npm run build:client && npm run check",
    "build:client": "vite build --config client/vite.config.ts",
    "check": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.0",
    "@colyseus/ws-transport": "^0.18.0",
    "@colyseus/sdk": "^0.18.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
