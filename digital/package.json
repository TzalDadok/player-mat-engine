{
  "name": "aoe-boardgame-digital",
  "private": true,
  "scripts": {
    "dev": "npm run build:client && wrangler dev",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "npm run build:client",
    "build:client": "vite build --config client/vite.config.ts",
    "deploy": "npm run build && wrangler deploy",
    "check": "tsc -p client/tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20261001.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  }
}
